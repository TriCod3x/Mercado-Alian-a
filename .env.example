# O servidor lê estas variáveis do ambiente (shell ou painel do Railway).
# Para usar um arquivo .env localmente:  node --env-file=.env server/index.js
# NUNCA coloque o .env no git (ele já está no .gitignore).

# --- Banco de dados (Supabase) ---------------------------------------------
# Supabase → seu projeto → botão "Connect" (topo) → "Session pooler" → URI.
# Troque [YOUR-PASSWORD] pela senha do banco (Project Settings → Database).
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# require = conexão criptografada (padrão). verify = exige DATABASE_CA_CERT. disable = só Postgres local.
DATABASE_SSL=require
# Recomendado: certificado do Supabase (Project Settings → Database → SSL Configuration → Download certificate).
# Aceita o caminho do arquivo .crt ou o conteúdo PEM inteiro. Com ele, o certificado do servidor é verificado.
DATABASE_CA_CERT=
# Máximo de conexões abertas por este servidor.
PG_POOL_MAX=10

# --- Aplicação ---------------------------------------------------------------
PORT=3000
ADMIN_USER=dono
ADMIN_PASSWORD=troque-por-uma-senha-forte
TZ_OFFSET_MINUTES=-180
# TRUST_PROXY=1   (automático no Railway)

# --- Testes (opcional) -------------------------------------------------------
# Sem isto, "npm test" usa um PostgreSQL embutido (PGlite). Com isto, usa um
# Postgres real — use um projeto/banco SÓ DE TESTE, nunca o de produção.
# TEST_DATABASE_URL=
